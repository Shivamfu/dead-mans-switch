# Server Configuration
PORT=3500
NODE_ENV=development
APP_URL=http://localhost:3500

# Security & Tokens
JWT_SECRET=memento_vault_jwt_secret_dev_3821098471092834
SYSTEM_MASTER_SALT=dead_mans_switch_kdf_salt_5510294875928

# PostgreSQL Database
# If PostgreSQL is not reachable, the app automatically runs in embedded/in-memory mode for development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deadmansswitch

# Redis & BullMQ
# If Redis is not reachable, the app automatically uses internal in-memory queue runner for development
REDIS_URL=redis://127.0.0.1:6379

# Email Dispatcher
# Providers: 'console' (prints email preview to console), 'ethereal' (auto test accounts), 'nodemailer' (SMTP), 'resend' (Resend API)
EMAIL_PROVIDER=console
EMAIL_FROM=Dead Man's Switch Vault <noreply@vault.local>

# Resend API Key (Optional, if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP Configuration (Optional, if EMAIL_PROVIDER=nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Check-in intervals defaults (in seconds)
DEFAULT_CHECKIN_INTERVAL=2592000 # 30 days
DEFAULT_GRACE_PERIOD=604800      # 7 days
# For rapid testing, intervals can be set to e.g. 60s and 30s in the UI or API
